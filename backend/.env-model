# ============================================================
#  Zero 14 — variáveis de ambiente (MODELO)
#  Copie este arquivo para ".env" e preencha os valores reais.
#  O .env NÃO vai para o Git (está no .gitignore).
# ============================================================

# ===== Banco de dados (SQL Server) =====
# IMPORTANTE: se o servidor tiver "\" (ex: SQLEXPRESS), NÃO use aspas —
# o DotNetEnv "come" a barra dentro de aspas.
# Autenticação do Windows (recomendado no dev): Trusted_Connection=True
CONNECTION_STRING=Server=SEU_SERVIDOR\SQLEXPRESS;Database=Zero14;Trusted_Connection=True;TrustServerCertificate=True

# ===== JWT (autenticação do painel) =====
JWT_SECRET="troque-por-uma-chave-secreta-bem-grande"
JWT_ISSUER="Zero14"
JWT_AUDIENCE="Zero14"
JWT_EXPIRACAO_MINUTOS="120"

# ===== Admin (seed inicial) =====
ADMIN_EMAIL="admin@grupozero14.com.br"
ADMIN_SENHA="troque-esta-senha"

# ===== Cloudinary (upload de imagens) =====
# Crie uma conta grátis em cloudinary.com e pegue no Dashboard.
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
CLOUDINARY_API_SECRET="sua-api-secret"
