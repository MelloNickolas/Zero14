# ============================================================
#  Zero 14 — variáveis de ambiente (MODELO)
#  Copie este arquivo para ".env" e preencha os valores reais.
#  O .env NÃO vai para o Git (está no .gitignore).
# ============================================================

# ===== Banco de dados (PostgreSQL / Neon) =====
# Pegue no painel do neon.tech (formato Npgsql). SSL é obrigatório no Neon.
CONNECTION_STRING=Host=SEU_HOST.neon.tech;Database=zero14;Username=SEU_USER;Password=SUA_SENHA;SSL Mode=Require;Trust Server Certificate=true

# ===== CORS (origens do front separadas por vírgula) =====
CORS_ORIGINS="http://localhost:5173"

# ===== JWT (autenticação do painel) =====
JWT_SECRET="troque-por-uma-chave-secreta-bem-grande"
JWT_ISSUER="Zero14"
JWT_AUDIENCE="Zero14"
JWT_EXPIRACAO_MINUTOS="120"

# ===== Admin (seed inicial) =====
ADMIN_EMAIL="admin@grupozero14.com.br"
ADMIN_SENHA="troque-esta-senha"

# ===== Cloudinary (upload de imagens) =====
# Crie uma conta grátis em cloudinary.com e pegue no Dashboard.
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
CLOUDINARY_API_SECRET="sua-api-secret"
